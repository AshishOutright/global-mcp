# Leave empty to run the self-contained DEMO (in-browser data, perfect for GitHub Pages).
# Set to the GMCP backend API to run LIVE against the PHP backend (must be same origin,
# e.g. build is served from https://gmcp.outrightcrm.in/app/):
#   VITE_GMCP_API_URL=/index.php?entryPoint=gmcp_api
VITE_GMCP_API_URL=

# Public MCP host shown in snippets while in demo mode
VITE_GMCP_PUBLIC_HOST=https://gmcp.outrightcrm.in
